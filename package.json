{
  "name": "functions",
  "description": "Sapper SSR on Firebase",
  "scripts": {
    "lint": "eslint .",
    "serve": "npm run build && firebase serve",
    "serve_node": "npm run build && node __sapper__/build",
    "serve_functions": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start_functions": "npm run shell",
    "deploy": "npm run build && firebase deploy",
    "logs": "firebase functions:log",
    "build_ts": "tsc src/firebase/*.ts --outDir lib/firebase --tsBuildInfoFile lib/firebase/build.json --incremental --esModuleInterop --skipLibCheck",
    "build_sapper": "sapper build && (pkill -f \"server.js$|sapper dev$\"||true)",
    "build": "sapper build && make firebase && (pkill -f \"server.js$|sapper dev$\"||true)",
    "dev": "make firebase && ./run_sapper_dev",
    "export": "sapper export",
    "serve_export": "npx serve __sapper__/export",
    "start": "node __sapper__/build",
    "validate": "svelte-check --ignore src/node_modules/@sapper",
    "test:e2e": "tests/e2e/run.sh",
    "test:e2e:update": "tests/e2e/run.sh --update-snapshots",
    "test:e2e:serve": "tests/e2e/serve.sh"
  },
  "main": "lib/firebase/functions.js",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@types/mime": "^3.0.4",
    "compression": "^1.7.4",
    "express": "^4.21.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "http-proxy-middleware": "^3.0.3"
  },
  "overrides": {
    "http-proxy": "npm:http-proxy-3@^1.23.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.8",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.25.7",
    "@babel/preset-env": "^7.25.8",
    "@babel/runtime": "^7.25.7",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@jupyterlab/services": "^7.2.5",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-typescript": "^12.1.1",
    "@rollup/plugin-url": "^8.0.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/compression": "^1.7.5",
    "@types/node": "^22.7.7",
    "chokidar": "^4.0.1",
    "cookie-parser": "^1.4.7",
    "eslint": "^9.13.0",
    "js-sha1": "^0.7.0",
    "lodash": "^4.17.21",
    "marked": "^15.0.12",
    "marked-extended-tables": "^2.0.1",
    "marked-highlight": "^2.2.4",
    "murmurhash3js-revisited": "^3.0.0",
    "rollup": "^4.24.0",
    "rollup-plugin-svelte": "^7.2.2",
    "rollup-plugin-terser": "^7.0.2",
    "sapper": "^0.29.3",
    "sirv": "^3.0.0",
    "svelte": "^4.2.19",
    "svelte-check": "^4.0.5",
    "svelte-loading-spinners": "^0.3.6",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.6.3",
    "ua-parser-js": "^1.0.39",
    "utf8": "^3.0.0"
  },
  "private": true
}

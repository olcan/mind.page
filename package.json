{
  "name": "functions",
  "type": "module",
  "description": "Sapper SSR on Firebase",
  "scripts": {
    "lint": "eslint .",
    "serve": "npm run build && firebase serve",
    "serve_node": "npm run build && node server.mjs",
    "serve_functions": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start_functions": "npm run shell",
    "deploy": "npm run build && firebase deploy",
    "logs": "firebase functions:log",
    "build": "vite build && make firebase",
    "dev": "vite dev",
    "start": "node server.mjs",
    "validate": "svelte-check --ignore src/node_modules/@sapper",
    "test:e2e": "tests/e2e/run.sh",
    "test:e2e:update": "tests/e2e/run.sh --update-snapshots",
    "test:e2e:serve": "tests/e2e/serve.sh",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --threshold error",
    "check:tests": "tsc -p tests",
    "test:dev-smoke": "node tests/e2e/dev_smoke.mjs",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:function-smoke": "tests/e2e/function_smoke.sh"
  },
  "main": "lib/firebase/functions.js",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "http-proxy-middleware": "^4.2.0",
    "mime": "^4.1.0",
    "sirv": "^3.0.0"
  },
  "overrides": {
    "http-proxy": "npm:http-proxy-3@^1.23.3",
    "uuid": "^13.0.0",
    "cookie": "^0.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@jupyterlab/services": "^7.2.5",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/compression": "^1.7.5",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "chokidar": "^5.0.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "js-sha1": "^0.7.0",
    "lodash": "^4.17.21",
    "marked": "^18.0.10",
    "marked-highlight": "^2.2.4",
    "murmurhash3js-revisited": "^3.0.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-loading-spinners": "^0.3.6",
    "typescript": "^6.0.3",
    "utf8": "^3.0.0",
    "vite": "^8.2.2"
  },
  "private": true,
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "@firebase/util@1.15.3": true
  }
}

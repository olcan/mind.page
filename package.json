{
  "name": "functions",
  "description": "Sapper SSR on Firebase",
  "scripts": {
    "lint": "eslint .",
    "serve": "npm run build && firebase serve",
    "serve_node": "npm run build && node server.mjs",
    "serve_functions": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start_functions": "npm run shell",
    "deploy": "npm run build && firebase deploy",
    "logs": "firebase functions:log",
    "build_ts": "tsc src/firebase/*.ts --outDir lib/firebase --tsBuildInfoFile lib/firebase/build.json --incremental --esModuleInterop --skipLibCheck",
    "build": "vite build && make firebase",
    "dev": "vite dev",
    "start": "node server.mjs",
    "validate": "svelte-check --ignore src/node_modules/@sapper",
    "test:e2e": "tests/e2e/run.sh",
    "test:e2e:update": "tests/e2e/run.sh --update-snapshots",
    "test:e2e:serve": "tests/e2e/serve.sh",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --threshold error",
    "check:tests": "tsc --noEmit --skipLibCheck --target es2022 --module nodenext --moduleResolution nodenext --strict tests/e2e/*.ts playwright.config.ts"
  },
  "main": "lib/firebase/functions.js",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "http-proxy-middleware": "^3.0.3",
    "mime": "^3.0.0",
    "sirv": "^3.0.0"
  },
  "overrides": {
    "http-proxy": "npm:http-proxy-3@^1.23.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@jupyterlab/services": "^7.2.5",
    "@octokit/rest": "^22.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/compression": "^1.7.5",
    "@types/lodash": "^4.17.25",
    "@types/mime": "^3.0.4",
    "@types/node": "^22.7.7",
    "chokidar": "^4.0.1",
    "eslint": "^9.13.0",
    "js-sha1": "^0.7.0",
    "lodash": "^4.17.21",
    "marked": "^15.0.12",
    "marked-extended-tables": "^2.0.1",
    "marked-highlight": "^2.2.4",
    "murmurhash3js-revisited": "^3.0.0",
    "svelte": "^4.2.19",
    "svelte-check": "^4.0.5",
    "svelte-loading-spinners": "^0.3.6",
    "typescript": "^5.6.3",
    "ua-parser-js": "^1.0.39",
    "utf8": "^3.0.0",
    "vite": "^5.4.21"
  },
  "private": true
}

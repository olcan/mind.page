{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "target": "ES2018",
    "strict": false,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2021", "WebWorker"]
  },
  // kit's generated include also covers tests/**, whose window declarations (tests/e2e/helpers.ts)
  // are stricter than the app's loose usage; tests type-check standalone via check:tests instead
  "include": [
    ".svelte-kit/ambient.d.ts",
    ".svelte-kit/non-ambient.d.ts",
    ".svelte-kit/types/**/$types.d.ts",
    "vite.config.mts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte"
  ]
}
